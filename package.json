{
  "name": "rag-proj",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "dev:api": "pnpm --filter api start:dev",
    "dev:ui": "pnpm --filter ui dev",
    "dev": "pnpm -r --parallel --filter api --filter ui run dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter api test",
    "infra:native": "./scripts/weaviate-native.sh",
    "infra:models": "ollama pull paraphrase-multilingual && ollama pull qwen2.5:1.5b"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1"
  }
}
