PORT=4000
CORS_ORIGIN=http://localhost:3000

# Weaviate (self-hosted via docker compose at repo root)
WEAVIATE_HOST=localhost
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051

# Generative module (RAG answers). The endpoint is resolved FROM INSIDE the
# weaviate container, so it uses the compose service name, not localhost.
OLLAMA_ENDPOINT=http://ollama:11434
OLLAMA_MODEL=llama3.2

# Upload limits
MAX_UPLOAD_MB=25
