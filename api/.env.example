PORT=4000
CORS_ORIGIN=http://localhost:3000

# Weaviate (self-hosted; native binary via `pnpm infra:native`, or docker compose)
WEAVIATE_HOST=localhost
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051

# Ollama serves both the embedding model and the LLM.
# This endpoint is called BY WEAVIATE, so it must be reachable from Weaviate:
#   native Weaviate        -> http://localhost:11434
#   Weaviate in docker     -> http://ollama:11434  (compose service name)
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_EMBED_MODEL=paraphrase-multilingual
OLLAMA_MODEL=qwen2.5:1.5b
# NOTE: these three are baked into the DocumentChunk collection when it is first
# created. After changing them, delete the collection and re-ingest.

# OCR for scanned PDF pages (tesseract.js language codes, English first)
OCR_LANGS=eng+hin

# Upload limits
MAX_UPLOAD_MB=25
