PORT=4000
CORS_ORIGIN=http://localhost:3000

# Weaviate (self-hosted; native binary via `pnpm infra:native`, or docker compose)
WEAVIATE_HOST=localhost
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051

# Ollama serves both the embedding model and the LLM.
# This endpoint is called BY WEAVIATE, so it must be reachable from Weaviate:
#   native Weaviate        -> http://localhost:11434
#   Weaviate in docker     -> http://ollama:11434  (compose service name)
OLLAMA_ENDPOINT=http://localhost:11434
# Address the API itself uses for Ollama (chat, descriptions). Defaults to OLLAMA_ENDPOINT;
# set to http://localhost:11434 when OLLAMA_ENDPOINT points inside Docker.
# OLLAMA_API_ENDPOINT=http://localhost:11434
OLLAMA_EMBED_MODEL=paraphrase-multilingual
OLLAMA_MODEL=qwen2.5:1.5b
# NOTE: these three are baked into the DocumentChunk collection when it is first
# created. After changing them, delete the collection, restart the API and run
# `curl -X POST localhost:4000/documents/reprocess` to re-index everything.
#
# GPU server (16 GB, e.g. RTX 5070 Ti) recommended set:
#   OLLAMA_EMBED_MODEL=qwen3-embedding:4b
#   OLLAMA_MODEL=gemma4:12b
#   OLLAMA_NUM_CTX=8192
# Reasoning ("thinking") models answer faster and just as well without it.
# OLLAMA_THINK=false
# Minimum LLM context window (tokens).
# OLLAMA_NUM_CTX=4096

# OCR for scanned PDF pages.
#   tesseract (default): tesseract.js on the CPU, no GPU needed.
#   ollama: a vision model on the GPU (much better on Hindi scans); tesseract
#           stays as the fallback for any page the model fails on.
# OCR_ENGINE=ollama
# OCR_MODEL=qwen3-vl:8b
# tesseract.js language codes, English first
OCR_LANGS=eng+hin

# Reranker (optional): text-embeddings-inference serving bge-reranker-v2-m3
# (the `reranker` service in docker-compose.yml). Hybrid search fetches
# RERANK_CANDIDATES passages, the reranker keeps the best CHAT_PASSAGES, and
# its top score (0-1) replaces MIN_RELEVANCE as the "not covered" gate.
# RERANKER_URL=http://localhost:8082
# RERANK_CANDIDATES=20
# MIN_RERANK_SCORE=0.1
# CHAT_PASSAGES=3

# Upload limits
MAX_UPLOAD_MB=25

# SQLite database (documents, original files, page text)
DATA_DIR=./data

# Chat: below this best-passage similarity the question counts as not covered
MIN_RELEVANCE=0.5
